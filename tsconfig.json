{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["worker/**/*.js", "worker/**/*.ts", "shared/**/*.js", "worker-configuration.d.ts"]
}
