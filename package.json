{
  "name": "la-net",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "init": "node scripts/init.mjs",
    "build": "vite build",
    "start": "wrangler dev --config wrangler.local.jsonc --local --port 8787",
    "preview": "wrangler dev --config wrangler.local.jsonc --local --port 8787",
    "test": "node --test tests/*.test.js",
    "test:api": "node scripts/test-api.mjs",
    "test:abuse": "node scripts/test-abuse-ux.mjs",
    "test:browser": "node scripts/test-browser-compat.mjs",
    "test:devices": "node scripts/test-device-compat.mjs",
    "test:responsive": "node scripts/test-responsive.mjs",
    "test:music": "node scripts/test-music-records.mjs",
    "test:course-grades": "node scripts/test-course-grades.mjs",
    "test:uploads": "node scripts/test-upload-safety.mjs",
    "test:pau": "node scripts/test-pau.mjs",
    "test:pau-top5": "node scripts/test-pau-top5.mjs",
    "test:contents": "node scripts/test-content-library.mjs",
    "test:mobile-startup": "node scripts/test-mobile-startup.mjs",
    "test:secret-room": "node scripts/test-secret-room.mjs",
    "test:predictions": "node scripts/test-predictions.mjs",
    "test:grade-activities": "node scripts/test-grade-activities.mjs",
    "test:bakery-minute": "node scripts/test-bakery-minute.mjs",
    "test:fast-uploads": "node scripts/test-fast-uploads.mjs",
    "google:configure": "node scripts/configure-google.mjs",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:deploy": "node scripts/deploy-pages.mjs",
    "google:pages-configure": "node scripts/configure-pages-google.mjs",
    "plan:check": "node scripts/check-plan.mjs",
    "plan:sync": "node scripts/check-plan.mjs --write",
    "lint": "eslint src worker shared scripts tests",
    "typecheck": "wrangler types --config wrangler.local.jsonc && tsc --noEmit && node scripts/check.mjs && npm run lint",
    "format": "prettier --write src worker shared scripts tests vite.config.js eslint.config.js wrangler.jsonc wrangler.local.jsonc package.json tsconfig.json",
    "cf:types": "wrangler types --config wrangler.local.jsonc",
    "cf:check": "npm run pages:build && node --test tests/pages-entry.test.js",
    "cf:prepare": "node scripts/cloud-prepare.mjs",
    "cf:deploy": "node scripts/cloud-deploy.mjs",
    "test:mobile-navigation": "node scripts/test-mobile-navigation.mjs",
    "audit:source": "node scripts/audit-public-source.mjs",
    "release": "node scripts/release.mjs",
    "test:roulette-board": "node scripts/test-roulette-board.mjs",
    "test:roulette-animation": "node scripts/test-roulette-animation.mjs",
    "test:schedule-cards": "node scripts/test-schedule-cards.mjs",
    "test:workspace-recovery": "node scripts/test-workspace-recovery.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "jose": "6.2.12",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsonc-parser": "^3.3.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^7.1.9",
    "wrangler": "^4.149.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/21052claver-ship-it/lanet.git"
  },
  "homepage": "https://lanet.pages.dev"
}
