{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lanet",
  "account_id": "bae727f7e92ad7610919d21b6409ade1",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "la-net-db",
      "migrations_dir": "migrations",
      "database_id": "bcea5200-4b6d-43ff-b214-7612b633d3b6",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "la-net-files",
      "jurisdiction": "eu",
    },
  ],
  "vars": {
    "SCHOOL_NAME": "La Net",
    "DEMO_MODE": "false",
    "GUEST_ACCESS": "false",
    "GOOGLE_ALLOWED_DOMAIN": "fje.edu",
    "GOOGLE_REDIRECT_URI": "https://lanet.impossible-goals-research.workers.dev/api/auth/google/callback",
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
  },
}
